QWEN_API_KEY=replace-with-your-qwen-api-key
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OCR backend selection. Explicit OCR_BACKEND wins over USE_QWEN_VL_OCR.
# Supported values: qwen_vl, paddle, ascend_cann, mindx.
OCR_BACKEND=qwen_vl
USE_QWEN_VL_OCR=true

# Ascend / MindX placeholders for future Atlas deployment.
ASCEND_DEVICE_ID=0
ASCEND_MODEL_DIR=models/ascend
MINDX_PIPELINE_URL=http://127.0.0.1:8080/infer
