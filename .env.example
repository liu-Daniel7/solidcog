# 也可以在启动后的“处理设置”里填写；保存后会写回本文件。
QWEN_API_KEY=replace-with-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_MT_MODEL=qwen-mt-plus
# Qwen-MT 默认复用 QWEN_BASE_URL；只有模型位于另一地域时才需要覆盖。
# QWEN_MT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MT_TIMEOUT_SECONDS=60
QWEN_OCR_MAX_PAGES=10
TRANSLATION_MAX_WORKERS=3

# MechVL 经本地调度器（MODEL_SCHEDULER_BASE_URL）代理，无需直连地址。
MECHVL_TIMEOUT_SECONDS=600
MECHVL_STARTUP_TIMEOUT=900

# Lightweight WSL model scheduler. MinerU and MechVL are mutually exclusive.
MODEL_SCHEDULER_BASE_URL=http://127.0.0.1:8090
MODEL_SWITCH_TIMEOUT_SECONDS=360
MINERU_TIMEOUT_SECONDS=600

# macOS / Apple Silicon platform layer (platforms/macos)
# LLAMA_SERVER_PATH=/absolute/path/to/llama-server
# SOLIDCOG_MAC_PYTHON=/absolute/path/to/project/.venv/bin/python
MINERU_MODEL_PATH=models/mineru/mineru-text-q8.gguf
MINERU_MMPROJ_PATH=models/mineru/mineru-vision-f16.gguf
MECHVL_MODEL_PATH=models/mechvl/mechvl-model-q5.gguf
MECHVL_MMPROJ_PATH=models/mechvl/mechvl-vision-f16.gguf
MINERU_CONTEXT=8192
MECHVL_CONTEXT=8192

# 齐套性检查：单批次图纸上限、每张图纸尺寸视觉复核页数上限。
MAX_COMPLETENESS_DRAWINGS=100
COMPLETENESS_DIMENSION_MAX_PAGES=8
